[Unit]
Description=T3 Gemstone O1 Hardware Test API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/gemstone
Environment="PATH=/home/gemstone/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/gemstone/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
